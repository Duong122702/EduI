# ==========================================
# 1. THƯ MỤC HỆ THỐNG & CHUNG
# ==========================================
.git/
.github/
.vscode/
.idea/
.DS_Store
*.log
*.bak
*.swp

# ==========================================
# 2. BẢO MẬT (Rất quan trọng)
# ==========================================
# Tránh để Cline đọc và leak key API ra ngoài log
.env
.env.*
*.pem
*.key

# ==========================================
# 3. FRONTEND (React + Vite + Node.js)
# ==========================================
# Thư viện - Tuyệt đối không để AI mò vào đây
node_modules/
# File Lock - Ngốn cực nhiều token (có thể lên tới 50k - 100k token)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
# Build output
dist/
build/
# Cache
.eslintcache
.vite/

# ==========================================
# 4. BACKEND (FastAPI + Pydantic + Python)
# ==========================================
# Môi trường ảo (Virtual Environments)
venv/
.venv/
env/
# Bytecode và Cache của Python (Rác hệ thống)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
# File cơ sở dữ liệu cục bộ (Dữ liệu thô, không phải logic code)
*.sqlite
*.sqlite3
*.db
# File build/packaging của Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg